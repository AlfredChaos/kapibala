# server 运行配置（变量表：docs/design/01-architecture.md §6.1）。复制为 .env 后按需修改。
# 必填四项（缺失即拒绝启动）：
PORT=3000
DATABASE_URL=postgres://kapibala:kapibala@localhost:5432/kapibala
GATEWAY_URL=http://localhost:4100
AGENT_URL=http://localhost:4200

# 可选调参（注释掉 = 用默认值；默认值出处同上 §6.1）：
# AGENT_TURN_TIMEOUT_MS=12000        # /agent/turn 单轮超时，契约区间 10–15s（A5-2）
# AGENT_MAX_CONCURRENT_RUNS=50       # agent run 全局并发闸（进程内信号量，DES/06 §2.1、DES/13 §4）
# MEDIA_RETENTION_DAYS=30            # C1 媒体保留期
# WS_EVENT_RETENTION_MINUTES=30      # ws_event 保留窗口（远大于 B4 的 3s 补齐要求）
