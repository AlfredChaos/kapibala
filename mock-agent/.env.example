# mock-agent 配置（变量表：docs/design/12-agent-service.md §6）
PORT=4200
# scripted | anthropic（默认 scripted）
AGENT_MODE=scripted

# —— C2 双实例部署（DES/12 §5）——
# 同一包用不同 env 起第二个实例即得 anthropic 版，后端只改 AGENT_URL 指向它：
#   实例 A（默认/测试/演示）：PORT=4200 AGENT_MODE=scripted
#   实例 B（真实 LLM）     ：PORT=4300 AGENT_MODE=anthropic ANTHROPIC_API_KEY=sk-ant-…
#   后端 server/.env：AGENT_URL=http://localhost:4300 → 重启即切换，代码零改动。
# 仅 anthropic 模式需要；key 只进本地 .env，绝不提交（根 AGENTS.md §5 + .gitignore 双保险）
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-4-5
